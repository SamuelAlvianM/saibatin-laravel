# =============================================================================
#  ISI SEKALI DI LAPTOP — lalu tidak perlu menyentuh .env di server lagi
# =============================================================================
#
#  1. Salin berkas ini jadi  deploy/.env.produksi
#  2. Isi bagian DB_* dan MAIL_* di bawah
#  3. Jalankan  deploy\buat-paket.ps1
#
#  Skrip paket akan:
#    · menyalin berkas ini menjadi `.env` di dalam paket
#    · MENGISI APP_KEY sendiri kalau masih kosong (jadi tidak perlu
#      `php artisan key:generate` di server — penting kalau akun cPanel Anda
#      tidak punya Terminal)
#    · menolak berjalan kalau DB_DATABASE / DB_USERNAME / DB_PASSWORD kosong
#
#  🔴 `deploy/.env.produksi` sudah masuk .gitignore. Jangan pernah di-commit —
#     isinya kredensial database produksi.
#
# =============================================================================
#  CARA MENDAPATKAN NILAI DB_* (cPanel → MySQL® Databases)
#
#   1. "Create New Database": ketik mis. `saibatin`.
#      🔴 cPanel menambahkan awalan nama akun → jadi `namaakun_saibatin`.
#         Yang ditulis di DB_DATABASE adalah nama LENGKAP berawalan itu.
#   2. "Add New User": sama, hasilnya `namaakun_saibatin`. Pakai Password
#      Generator, lalu salin sandinya ke DB_PASSWORD.
#   3. "Add User To Database" → pilih keduanya → centang ALL PRIVILEGES.
#      Tanpa langkah ini galatnya berbunyi "Access denied" dan mudah dikira
#      sandi salah.
#   4. DB_HOST TETAP 127.0.0.1 — di cPanel, MySQL satu mesin dengan PHP.
# =============================================================================

APP_NAME="SAIBATIN - Disdukcapil Pesisir Barat"
APP_ENV=production
APP_DEBUG=false

# Biarkan KOSONG — diisi otomatis oleh buat-paket.ps1.
APP_KEY=

APP_URL=https://disdukcapil.pesisirbaratkab.go.id

APP_LOCALE=id
# 🔴 `en`, jangan disamakan dengan APP_LOCALE — kalau sama, aturan validasi yang
# belum diterjemahkan tampil sebagai kunci mentah ("validation.required") di
# formulir pendaftaran warga.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ── DATABASE — WAJIB DIISI ───────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Sesi ─────────────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_COOKIE=saibatin_session
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# 🔴 `true` karena .htaccess memaksa HTTPS. Kalau situs diakses lewat http://
# biasa, cookie ini tidak akan pernah terkirim dan login selalu gagal tanpa
# pesan — pastikan redirect HTTPS-nya benar-benar jalan.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ── Email — isi kalau reset sandi warga harus benar-benar terkirim ───────────
# cPanel → Email Accounts → Connect Devices untuk melihat host & port.
# `log` hanya menulis ke berkas log dan TIDAK mengirim apa pun.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="disdukcapil@pesisirbaratkab.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# ── Identitas situs ──────────────────────────────────────────────────────────
SITE_KODE=1813
SITE_TENANT=disdukcapil
SITE_TENANT2="dinas dukcapil"
SITE_NAMA_LENGKAP="pesisir barat"
SITE_NAMA_PENDEK=pesisirbarat
SITE_NAMA_POPULER=saibatin
SITE_KETERANGAN=pelayanan
SITE_VERSI=24.03.30.001
SITE_TAHUN_COPYRIGHT=2024

# ── Opsional ─────────────────────────────────────────────────────────────────
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
OTP_CHANNEL=email
FONNTE_TOKEN=
MASTER_PASSWORD=

# ── Survei Kepuasan Masyarakat ──────────────────────────────────────────────
# Kuesioner 16 pertanyaan (berkas Word dinas, 17 Agu 2026).
#
# false = warga melihat "survei sedang disiapkan"; petugas yang LOGIN tetap
#         melihat formulir lengkapnya, jadi dinas bisa memeriksanya langsung di
#         portal produksi. Endpoint POST /api/skm ikut menolak pengiriman dari
#         non-petugas, bukan cuma formulirnya yang disembunyikan.
#
# Biarkan false sampai dinas menyetujui susunan pertanyaannya (keputusan user
# 18 Agu). Setelah diubah ke true WAJIB `php artisan config:cache` — konfigurasi
# yang sudah di-cache tidak membaca .env lagi.
SKM_TERBUKA=false
